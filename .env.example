NEXT_PUBLIC_SITE_URL=https://mbasaran.dev
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_TWITTER_URL=

# Featured Projects (Optional Live Demo & Repository Overrides)
