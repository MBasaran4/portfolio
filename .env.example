# GitHub API Integration (Server Component cached fetch)
# Optional: Public repos will stream automatically when username is set.
GITHUB_USERNAME=
# Optional: Only needed if you experience GitHub API rate limits (5000 req/hr vs 60 req/hr)
GITHUB_TOKEN=

# Contact & Profile Credentials
